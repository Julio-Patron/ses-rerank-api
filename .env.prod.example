# ==============================================================================
# Semantic Engine Production Configuration Template (.env.prod)
# Generate a live production file automatically with: python scripts/deploy_production.py
# ==============================================================================

# Core & Security. DEBUG is forced false by docker-compose.prod.yml.
DEBUG=false
GATEWAY_ADMIN_KEY=change_me_to_a_secure_random_64_char_hex_key

# Postgres billing store. Required. Do not point production at SQLite.
POSTGRES_USER=ses
POSTGRES_PASSWORD=change_me_to_a_secure_random_32_char_hex_key
POSTGRES_DB=ses_gateway

# Redis rate limiter and idempotency cache
REDIS_PASSWORD=change_me_to_a_secure_random_32_char_hex_key

# Stripe credit packs. Checkout stays unavailable until the Price IDs are set.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DEVELOPER=
STRIPE_PRICE_GROWTH=
STRIPE_CREDITS_DEVELOPER=10000
STRIPE_CREDITS_GROWTH=100000

# Network bindings default to localhost.
GATEWAY_BIND_IP=127.0.0.1
PORTAL_BIND_IP=127.0.0.1
GATEWAY_CORS_ORIGINS=http://127.0.0.1:3000
NEXT_PUBLIC_SES_API_URL=http://127.0.0.1:8000
BILLING_SUCCESS_URL=http://127.0.0.1:3000/billing/success
BILLING_CANCEL_URL=http://127.0.0.1:3000/billing
