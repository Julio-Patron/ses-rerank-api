# ==============================================================================
# Semantic Engine Production Configuration Template (.env.prod)
# Generate a live production file automatically with: python scripts/deploy_production.py
# ==============================================================================

# Core & Security
DEBUG=false
GATEWAY_ADMIN_KEY=change_me_to_a_secure_random_64_char_hex_key

# Qdrant Vector Store
QDRANT_API_KEY=change_me_to_a_secure_random_32_char_hex_key

# Redis In-Memory Cache & Rate Limiter
REDIS_PASSWORD=change_me_to_a_secure_random_32_char_hex_key

# Local LLM Integration
OLLAMA_MODEL=llama3.2

# Network Bindings (Defaults to localhost for maximum security)
GATEWAY_BIND_IP=127.0.0.1
PORTAL_BIND_IP=127.0.0.1
GATEWAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_SES_API_URL=http://localhost:8000
