# ============================================================
# SES Core — Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in real values.
# Lines starting with # are comments. Uncomment to override.
# ============================================================

# --- General ---
# Set to "true" only during local development.
# In production this MUST be "false" to enforce fail-closed security.
DEBUG=false

# --- Enterprise Gateway ---
# Required whenever the Gateway is started. Generate a unique value with:
#   python scripts/rotate_local_secrets.py
# Never reuse the example value or commit the generated .env file.
GATEWAY_ADMIN_KEY=replace_with_a_unique_ses_key_of_at_least_32_characters
# Comma-separated browser origins allowed to call the Gateway.
GATEWAY_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://localhost:3000

# --- Embedding Model ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
# VECTOR_SIZE is fixed at 384 for the default model

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Qdrant (Vector Store) ---
QDRANT_URL=http://localhost:6333
# Required in production (DEBUG=false):
QDRANT_API_KEY=change_me

# --- Redis (Rate Limiting & Usage Tracking) ---
REDIS_HOST=localhost
REDIS_PORT=6379
# Required in production (DEBUG=false):
REDIS_PASSWORD=change_me

# --- PostgreSQL (optional; default is SQLite) ---
# Set POSTGRES_ENABLED=true to use Postgres instead of local SQLite.
POSTGRES_ENABLED=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ses_gateway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# --- Stripe credit packs ---
# Leave empty until Checkout is configured. Packs are selected by Price ID, never by amount.
# DEBUG must stay false outside local development; ?simulated=true is rejected unless it is true.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DEVELOPER=
STRIPE_PRICE_GROWTH=
STRIPE_CREDITS_DEVELOPER=10000
STRIPE_CREDITS_GROWTH=100000
STRIPE_RATE_LIMIT_DEVELOPER=60
STRIPE_RATE_LIMIT_GROWTH=500
BILLING_SUCCESS_URL=http://127.0.0.1:3000/billing/success
BILLING_CANCEL_URL=http://127.0.0.1:3000/billing

# --- LLM / RAG ---
# Primary provider for answer generation (Local 100% Offline)
OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=60

# --- File Watcher (Mount Mode) ---
# Comma-separated directories to watch for new/changed files.
# WATCH_DIRECTORIES=/home/user/Documents,/home/user/Downloads
PERSONAL_NAMESPACE=personal_default
DEBOUNCE_SECONDS=2.0
MOUNT_MANIFEST_PATH=data/mount_manifest.json
